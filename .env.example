# Variables pour docker-compose.yml (stack complet : backend + postgres + orthanc)
# Copiez ce fichier en .env à la racine du dépôt et renseignez une vraie valeur.
# Sans ce fichier, `docker compose up` refuse de démarrer (voir POSTGRES_PASSWORD
# dans docker-compose.yml) plutôt que de retomber sur un mot de passe par défaut
# codé en dur et versionné.

# Générer une valeur forte, par ex. : openssl rand -hex 24
POSTGRES_PASSWORD=changez-moi-avec-une-longue-chaine-aleatoire-en-production
